# Meta Graph API
META_GRAPH_VERSION=v26.0
META_POST_LIMIT=100

# Preferred production auth — choose ONE durable option below.

# Option A: permanent/non-expiring Page access tokens.
# Value can be a JSON array or an object keyed by Page ID.
# Never commit real tokens to GitHub; set this only in Vercel Environment Variables.
META_PAGE_TOKENS_JSON=[{"pageId":"123456789","pageName":"Example Page","pageAccessToken":"replace_me","instagramBusinessAccountId":"1784..."}]

# Option B: Meta Business System User token + Business Portfolio ID.
# A System User token can be generated with a non-expiring lifetime when eligible.
META_SYSTEM_USER_ACCESS_TOKEN=replace_me
META_BUSINESS_ID=replace_me

# Fallback only: User access token from Graph API Explorer / Facebook Login.
# User tokens expire and should not be the only production credential.
META_USER_ACCESS_TOKEN=replace_me

# Optional single-Page alternative to META_PAGE_TOKENS_JSON.
META_PAGE_ID=
META_PAGE_NAME=
META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=
